# t2k.rsf -- makerom spec for the installable T2K title.
#
# This is the standard homebrew application spec. The values that are OURS
# rather than boilerplate are UniqueId and ProductCode (below); everything
# else is the permission/kernel envelope every 3dsx-derived CIA needs, and
# changing it without a reason will simply stop the title from launching.
#
# $(...) variables are substituted by makerom's -D flags -- see the `cia`
# target in ../Makefile.

BasicInfo:
  Title                   : "$(APP_TITLE)"
  ProductCode             : "$(APP_PRODUCT_CODE)"
  Logo                    : Homebrew

RomFs:
  RootPath                : $(APP_ROMFS)

TitleInfo:
  Category                : Application
  UniqueId                : $(APP_UNIQUE_ID)

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  # The romfs is ~300 MB of already-compressed DSP-ADPCM. EnableCompress
  # buys nothing on it and costs minutes of build time, so it is OFF -- the
  # code section is a rounding error next to the audio.
  EnableCompress          : false
  EnableCrypt             : false

AccessControlInfo:
  CoreVersion                   : 2

  # SystemMode 64MB is the ordinary application arrangement. The game's own
  # budget (DOCTRINE.md: ~89 MB granted by libctru, 10 MB of level-texture
  # masters in the ordinary heap, a separate 32 MB linear heap) is what this
  # has to keep satisfying, so do not drop it to a smaller arrangement.
  MemoryType                    : Application
  SystemMode                    : 64MB
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0
  HandleTableSize               : 0x200

  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # New 3DS: the extra core and the 804 MHz/L2 unlock the game asks for at
  # boot (applyNew3dsSpeedup) need this arrangement to be available.
  SystemModeExt                 : 124MB
  CpuSpeed                      : 804MHz
  EnableL2Cache                 : true
  CanAccessCore2                : false

  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "46"

  # DSP SHARED RAM. WITHOUT THIS THE TITLE CANNOT BOOT.
  #
  # A .3dsx under the Homebrew Launcher inherits the launcher's mappings and so
  # never needed this; a CIA gets exactly what its exheader asks for. ndspInit()
  # asks the dsp sysmodule to convert DSP addresses, then writes through the
  # pointer it gets back -- so with these pages unmapped the very first store
  # (`*ndspVars[0][0] = 4`, ndsp.c:60 inlined into ndspInitialize) takes a data
  # abort. That is a crash at BOOT, before the main loop, not an audio glitch:
  # main() calls music_init() -> ndspInit() unconditionally.
  #
  # Diagnosed from a Luma dump 2026-09-03: pc in ndspSetCounter, far 0x1ff57ffe
  # (the last halfword of the first range below), dfsr 0x807 = write, page
  # translation fault. The two ranges are what every other libctru+ndsp port on
  # this machine declares.
  IORegisterMapping:
   - 1ff50000-1ff57fff
   - 1ff70000-1ff77fff
  MemoryMapping:
   - 1f000000-1f5fffff:r

  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    SetThreadPriority: 12
    SetTimer: 27
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37

  InterruptNumbers:
  ServiceAccessControl:
    - APT:U
    - ac:u
    - cfg:u
    - csnd:SND
    - dsp::DSP
    - fs:USER
    - gsp::Gpu
    - gsp::Lcd
    - hid:USER
    - ir:rst
    - ir:u
    - ir:USER
    - ndm:u
    - news:u
    - nwm::UDS
    - ptm:u
    - pxi:dev
    - soc:U
    - ssl:C
    - y2r:u
  FileSystemAccess:
    - CategorySystemApplication
    - CategoryHardwareCheck
    - CategoryFileSystemTool
    - Debug
    - TwlCardBackup
    - TwlNandData
    - Boss
    - DirectSdmc
    - Core
    - CtrNandRo
    - CtrNandRw
    - CtrNandRoWrite
    - CategorySystemSettings
    - CardBoard
    - ExportImportIvs
    - DirectSdmcWrite
    - SwitchCleanup
    - SaveDataMove
    - Shop
    - Shell
    - CategoryHomeMenu
  IoAccessControl:
    - FsMountNand
    - FsMountNandRoWrite
    - FsMountTwln
    - FsMountWnand
    - FsMountCardSpi
    - UseSdif3
    - CreateSeed
    - UseCardSpi

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x40000

  # The standard homebrew dependency list. libctru links against these
  # sysmodules; a missing entry shows up as a service that will not open.
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    camera: 0x0004013000001602
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dlp: 0x0004013000002802
    dsp: 0x0004013000001a02
    friends: 0x0004013000003202
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    news: 0x0004013000003502
    nfc: 0x0004013000004002
    nim: 0x0004013000002c02
    nwm: 0x0004013000002d02
    pdn: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    qtm: 0x0004013020004202
    ro: 0x0004013000003702
    socket: 0x0004013000002e02
    spi: 0x0004013000002302
    ssl: 0x0004013000002f02
